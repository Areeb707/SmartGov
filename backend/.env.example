# Environment Variables
# Copy this file to .env and fill in your API keys

# Serper API Key for web search (scheme discovery)
# Get your key at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# OpenRouter API Key for LLM (rule interpretation)
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ElevenLabs API Key for text-to-speech (accessibility feature)
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# VirusTotal API Key for phishing URL detection
# Get your key at: https://www.virustotal.com/ (free tier available)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Server Port (optional, defaults to 3000)
PORT=3000
